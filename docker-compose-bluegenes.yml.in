services:
  bluegenes_@@mine_name@@:
    container_name: intermine_bluegenes_@@mine_name@@
    restart: "${CADRE_RESTART_POLICY}"
    image: @@bluegenes_image@@
    volumes:
      - bluegenes_volume:/tools
    environment:
      - BLUEGENES_DEFAULT_SERVICE_ROOT="@@bluegenes_default_service_domain@@/@@mine_name@@"
      - BLUEGENES_BACKEND_SERVICE_ROOT="http://tomcat:${TOMCAT_PORT}/@@mine_name@@"
      - BLUEGENES_DEFAULT_MINE_NAME=@@mine_name@@
      - BLUEGENES_DEFAULT_NAMESPACE=@@mine_name@@
      - BLUEGENES_DEPLOY_PATH=/@@mine_name@@
      - HIDE_REGISTRY_MINES=true
    ports:
      - @@bluegenes_host_port@@:${BLUEGENES_PORT}
